# .env.example: settings for LOCAL test runs only (optional; copy to .env to use).
#
# The real settings for the weekly job live in GitHub:
#   Settings > Secrets and variables > Actions  (see OPERATING.md, step 7)
#
# NEVER put ANTHROPIC_API_KEY in this file or anywhere else on your computer. It belongs ONLY
# in GitHub Secrets. If it is set on your machine, Claude Code bills your API account instead of
# your subscription. Local runs use --mock-llm and need no key:
#
#   python -m src.main --dry-run --mock-llm
#
# This program ignores ANTHROPIC_API_KEY and BUTTONDOWN_API_KEY if they appear in .env.

# Where opinions come from: courtlistener (default) or sccourts (only with the court's permission;
# sccourts.org's robots.txt disallows automated agents).
SOURCE=courtlistener

# Optional: a free CourtListener API token gives complete results. Without it the public feeds are
# used, which list only the 20 newest decisions per court.
# COURTLISTENER_API_TOKEN=

CLAUDE_MODEL=claude-sonnet-5-5
SUMMARY_EFFORT=low
AUTO_SEND=false
INCLUDE_SUPREME_COURT=true
INCLUDE_COURT_OF_APPEALS=true
INCLUDE_ORDERS=true
MAX_OPINIONS_PER_RUN=25
MAX_INPUT_TOKENS_PER_OPINION=30000
MAX_OUTPUT_TOKENS=4000
LOOKBACK_DAYS=10

# Added to the User-Agent of every request so site operators can reach you. Optional with
# SOURCE=courtlistener; REQUIRED with SOURCE=sccourts (that mode stops before any request without it).
# CONTACT_EMAIL=you@example.com

# Optional: also email each new Buttondown draft to these addresses as a test send.
# BUTTONDOWN_TEST_RECIPIENTS=you@example.com
